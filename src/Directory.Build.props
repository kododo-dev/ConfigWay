<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>Kododo.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>Kododo.$(MSBuildProjectName)</RootNamespace>
    <PackageId>Kododo.$(MSBuildProjectName)</PackageId>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Kododo</Authors>
  </PropertyGroup>

  <!--
    ConfigWay.UI builds against Kododo.Way.Shell from NuGet; -p:UseLocalWayShell=true builds against the WayShell sources
    checked out next to this repository (../WayShell), to work on both at once.
  -->
  <PropertyGroup>
    <UseLocalWayShell Condition="'$(UseLocalWayShell)' == ''">false</UseLocalWayShell>
    <WayShellSource Condition="'$(WayShellSource)' == ''">$(MSBuildThisFileDirectory)..\..\WayShell\src</WayShellSource>
  </PropertyGroup>

</Project>


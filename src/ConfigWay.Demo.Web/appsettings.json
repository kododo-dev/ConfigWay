{
  "ConnectionStrings": {
    "DemoDB": "host=localhost;port=5432;database=configway;user id=postgres;password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Branding": {
    "CompanyName": "Acme Corp",
    "SupportEmail": "support@acme.example.com",
    "SupportPhone": "+1-800-555-0100",
    "MarketingSiteUrl": "https://acme.example.com"
  },
  "Smtp": {
    "Host": "smtp.sendgrid.net",
    "Port": 587,
    "UseSsl": true,
    "FromAddress": "noreply@acme.example.com",
    "FromName": "Acme Corp"
  },
  "Identity": {
    "Authority": "https://login.acme.example.com",
    "Audience": "acme-api",
    "ClientId": "acme-spa",
    "AccessTokenLifetimeMinutes": 60,
    "RequireHttpsMetadata": true
  },
  "Storage": {
    "Provider": "S3",
    "Region": "eu-central-1",
    "BucketName": "acme-assets",
    "PresignedUrlTtlSeconds": 900
  },
  "Webhooks": {
    "MaxRetries": 3,
    "AllowedOrigins": [
      "https://app.acme.example.com",
      "https://admin.acme.example.com"
    ],
    "Endpoints": [
      {
        "Url": "https://hooks.acme.example.com/order-created",
        "Secret": "default-hmac-secret",
        "Event": "OrderCreated"
      }
    ]
  },
  "feature_management": {
    "feature_flags": [
      {
        "id": "BetaBanner",
        "description": "Shows the beta banner on top of the site.",
        "enabled": true
      },
      {
        "id": "NewCheckout",
        "description": "Redesigned checkout flow, rolled out to beta testers first.",
        "enabled": true,
        "conditions": {
          "client_filters": [
            {
              "name": "Microsoft.Targeting",
              "parameters": {
                "Audience": {
                  "Users": [
                    "alice"
                  ],
                  "Groups": [
                    {
                      "Name": "beta-testers",
                      "RolloutPercentage": 100
                    }
                  ],
                  "DefaultRolloutPercentage": 0,
                  "Exclusion": {
                    "Users": [
                      "mallory"
                    ],
                    "Groups": []
                  }
                }
              }
            }
          ]
        }
      },
      {
        "id": "HolidayTheme",
        "description": "Festive colors over the holidays.",
        "enabled": true,
        "conditions": {
          "client_filters": [
            {
              "name": "Microsoft.TimeWindow",
              "parameters": {
                "Start": "Sun, 20 Dec 2026 00:00:00 GMT",
                "End": "Thu, 07 Jan 2027 00:00:00 GMT"
              }
            }
          ]
        }
      },
      {
        "id": "MaintenanceMode",
        "description": "Short-circuits the site into a maintenance page.",
        "enabled": false
      },
      {
        "id": "SearchEngine",
        "description": "Which search engine answers; a variant flag.",
        "enabled": true,
        "variants": [
          {
            "name": "Classic",
            "configuration_value": "bm25"
          },
          {
            "name": "Semantic",
            "configuration_value": "vector"
          }
        ],
        "allocation": {
          "default_when_enabled": "Classic",
          "user": [
            {
              "variant": "Semantic",
              "users": [
                "alice"
              ]
            }
          ]
        }
      }
    ]
  },
  "FeatureManagement": {
    "ReadOnlyMode": false
  }
}

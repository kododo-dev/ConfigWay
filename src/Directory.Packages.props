<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- The test host follows the runtime the tests run on. -->
  <PropertyGroup>
    <AspNetCoreTestVersion>10.0.15</AspNetCoreTestVersion>
    <AspNetCoreTestVersion Condition="'$(TargetFramework)' == 'net11.0'">11.0.0</AspNetCoreTestVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.* -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />

    <!-- ASP.NET Core test hosting -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(AspNetCoreTestVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="$(AspNetCoreTestVersion)" />

    <!-- Data access -->
    <PackageVersion Include="Npgsql" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="8.0.0" />

    <!-- ConfigWay.UI -->
    <PackageVersion Include="Kododo.Reiho.AspNetCore" Version="3.0.0" />
    <PackageVersion Include="Kododo.Way.Shell" Version="3.0.0" />

    <!-- ConfigWay.FeatureManagement -->
    <PackageVersion Include="Microsoft.FeatureManagement" Version="4.8.0" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
